# MAGMA runtime configuration example.
# Copy to .env or export these variables in your shell as needed.

# API
MAGMA_API_HOST=127.0.0.1
MAGMA_API_PORT=8904
MAGMA_API_BASE=http://127.0.0.1:8904

# Storage
# Defaults to ./data/magma.db when unset.
# MAGMA_DB_PATH=C:\openclaw-magma\data\magma.db

# Embedding
# Production default: cloud embedding keeps the 4B model out of local memory.
MAGMA_EMBEDDING_BACKEND=cloud
MAGMA_CLOUD_EMBEDDING_MODEL=text-embedding-v4
MAGMA_CLOUD_EMBEDDING_DIM=2048
# Export this outside the repo; never commit the real key.
# DASHSCOPE_API_KEY=<your_dashscope_api_key>

# Local fallback / offline mode:
# MAGMA_EMBEDDING_BACKEND=local
# MAGMA_EMBEDDING_MODEL=C:\openclaw-magma\models\Qwen\Qwen3-Embedding-4B
# HF_ENDPOINT=https://huggingface.co

# Background jobs
MAGMA_CONSOLIDATE_INTERVAL_SECONDS=3600
MAGMA_BACKUP_INTERVAL_SECONDS=86400
MAGMA_BACKUP_KEEP_DAYS=14
MAGMA_BACKUP_KEEP_LATEST=7

# MCP
MAGMA_API_TIMEOUT=30
