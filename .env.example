# MAGMA runtime configuration example.
# Copy to .env or export these variables in your shell as needed.

# API
MAGMA_API_HOST=127.0.0.1
MAGMA_API_PORT=8902
MAGMA_API_BASE=http://127.0.0.1:8902

# Storage
# Defaults to ./data/magma.db when unset.
# MAGMA_DB_PATH=C:\openclaw-magma\data\magma.db

# Embedding
MAGMA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://huggingface.co

# Background jobs
MAGMA_CONSOLIDATE_INTERVAL_SECONDS=3600
MAGMA_BACKUP_INTERVAL_SECONDS=86400
MAGMA_BACKUP_KEEP_DAYS=14
MAGMA_BACKUP_KEEP_LATEST=7

# MCP
MAGMA_API_TIMEOUT=30
